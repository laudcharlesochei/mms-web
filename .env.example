# Local development (Vite reads VITE_*; public/config.js also sets these at runtime)
VITE_API_BASE_URL=http://localhost:8080

# Heroku config vars read by server.js at runtime (no rebuild needed to change them)
API_BASE_URL=https://uod-ga-mms-api.herokuapp.com
# Only when the API runs with AUTH_MODE=entra:
ENTRA_CLIENT_ID=      # the mms-web SPA app registration (client) id
ENTRA_TENANT_ID=      # UoD tenant id
ENTRA_API_SCOPE=api://mms-api/access_as_user
